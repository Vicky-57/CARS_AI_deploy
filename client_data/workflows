    {
      "parameters": {
        "jsCode": "const message = $json.body || $json;\n\n// Handle different from header structures dynamically\nlet fromValue = '';\nif (typeof message.from === 'string') {\n  fromValue = message.from;\n} else if (message.from && typeof message.from === 'object') {\n  fromValue = message.from.text || '';\n  if (!fromValue && Array.isArray(message.from.value) && message.from.value.length > 0) {\n    const firstVal = message.from.value[0];\n    if (firstVal.name && firstVal.address) {\n      fromValue = `${firstVal.name} <${firstVal.address}>`;\n    } else if (firstVal.address) {\n      fromValue = firstVal.address;\n    }\n  }\n}\n\n// Fallbacks for standard headers\nif (!fromValue) {\n  fromValue = message.From || message.sender || '';\n}\n\n// Handle headers array format (Gmail trigger compatibility)\nif (!fromValue && message.payload && message.payload.headers) {\n  const fromObj = message.payload.headers.find(h => h.name === 'From' || h.name === 'from');\n  if (fromObj) fromValue = fromObj.value;\n}\n\nconst subject = message.subject || message.Subject || '(No Subject)';\nconst bodyText = message.text || message.snippet || message.textAsHtml || '';\nconst date = message.date || message.internalDate || new Date().toISOString();\nconst messageId = message.id || message.messageId || '';\n\n// Parse \"Name <email@example.com>\" OR just \"email@example.com\"\nlet email = '';\nlet senderName = 'Unknown Sender';\n\nconst angleMatch = fromValue.match(/<([^>]+@[^>]+)>/);\nif (angleMatch) {\n  email = angleMatch[1].trim();\n  const namePart = fromValue.substring(0, fromValue.indexOf('<')).trim();\n  senderName = namePart.replace(/[\"']/g, '').trim() || email.split('@')[0];\n} else if (fromValue.includes('@')) {\n  email = fromValue.trim();\n  senderName = fromValue.split('@')[0];\n}\n\nreturn [{\n  json: {\n    email,\n    senderName,\n    subject,\n    bodyText,\n    date,\n    messageId\n  }\n}];"
      },
