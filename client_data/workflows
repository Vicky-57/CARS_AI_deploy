    {
      "parameters": {
        "jsCode": "const summary = $json.content?.[0]?.text || 'No summary generated.';\nconst emailData = $('Code — Final Contact ID').first().json;\n\nconst noteBody = `✉️ EMAIL RECEIVED\\n\\nFrom: ${emailData.senderName} (${emailData.email})\\nSubject: ${emailData.subject}\\nDate: ${emailData.date}\\n\\nAI SUMMARY:\\n${summary}\\n\\nORIGINAL EMAIL BODY:\\n${emailData.bodyText.substring(0, 2000)}${emailData.bodyText.length > 2000 ? '...' : ''}`;\n\n// Escape all special chars so they don't break the JSON template\nconst noteBodySafe = JSON.stringify(noteBody).slice(1, -1);\n\nreturn [{\n  json: {\n    contactId: emailData.contactId,\n    noteBody: noteBodySafe\n  }\n}];"
