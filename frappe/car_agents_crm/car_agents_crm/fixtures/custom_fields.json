[
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "── Vehicle Information",
        "fieldname": "custom_vehicle_section",
        "fieldtype": "Section Break",
        "insert_after": "status",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Pipeline Type",
        "fieldname": "custom_pipeline_type",
        "fieldtype": "Select",
        "options": "sell\nbuy",
        "insert_after": "custom_vehicle_section",
        "in_list_view": 1,
        "in_filter": 1,
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Client Intent",
        "fieldname": "custom_client_intent",
        "fieldtype": "Select",
        "options": "\nBUY_INTENT\nSELL_INTENT\nUNKNOWN",
        "insert_after": "custom_pipeline_type",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "VIN",
        "fieldname": "custom_vin",
        "fieldtype": "Data",
        "insert_after": "custom_client_intent",
        "in_list_view": 1,
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Manufacturer",
        "fieldname": "custom_manufacturer",
        "fieldtype": "Data",
        "insert_after": "custom_vin",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Vehicle Model",
        "fieldname": "custom_vehicle_model",
        "fieldtype": "Data",
        "insert_after": "custom_manufacturer",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Initial Registration (EZ)",
        "fieldname": "custom_initial_registration",
        "fieldtype": "Date",
        "insert_after": "custom_vehicle_model",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Licence Plate (Kennzeichen)",
        "fieldname": "custom_licence_plate",
        "fieldtype": "Data",
        "insert_after": "custom_initial_registration",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Mileage (km)",
        "fieldname": "custom_mileage_km",
        "fieldtype": "Int",
        "insert_after": "custom_licence_plate",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Engine Power (kW)",
        "fieldname": "custom_power_kw",
        "fieldtype": "Int",
        "insert_after": "custom_mileage_km",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Engine Power (PS)",
        "fieldname": "custom_power_ps",
        "fieldtype": "Int",
        "insert_after": "custom_power_kw",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Displacement (ccm)",
        "fieldname": "custom_displacement_ccm",
        "fieldtype": "Int",
        "insert_after": "custom_power_ps",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "TÜV Expiry Date",
        "fieldname": "custom_tuv_expiry_date",
        "fieldtype": "Date",
        "insert_after": "custom_displacement_ccm",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Colour Code",
        "fieldname": "custom_colour_code",
        "fieldtype": "Data",
        "insert_after": "custom_tuv_expiry_date",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Transmission Code",
        "fieldname": "custom_transmission_code",
        "fieldtype": "Data",
        "insert_after": "custom_colour_code",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "OCR Status",
        "fieldname": "custom_ocr_status",
        "fieldtype": "Select",
        "options": "Pending\nProcessed\nVerified",
        "default": "Pending",
        "insert_after": "custom_transmission_code",
        "in_list_view": 1,
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "── OCR Extracted Vehicle Specs",
        "fieldname": "custom_vehicle_specs_section",
        "fieldtype": "Section Break",
        "insert_after": "custom_ocr_status",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Vehicle Document Specs",
        "fieldname": "custom_vehicle_specs",
        "fieldtype": "Table",
        "options": "Vehicle Document Spec",
        "insert_after": "custom_vehicle_specs_section",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "── Financial Summary",
        "fieldname": "custom_financial_section",
        "fieldtype": "Section Break",
        "insert_after": "custom_vehicle_specs",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Vehicle Purchase Price (€)",
        "fieldname": "custom_purchase_price",
        "fieldtype": "Currency",
        "options": "EUR",
        "insert_after": "custom_financial_section",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Final Sale Price (€)",
        "fieldname": "custom_final_sale_price",
        "fieldtype": "Currency",
        "options": "EUR",
        "insert_after": "custom_purchase_price",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Price Limit / Budget (€)",
        "fieldname": "custom_price_limit",
        "fieldtype": "Currency",
        "options": "EUR",
        "insert_after": "custom_final_sale_price",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Commission (€)",
        "fieldname": "custom_commission_eur",
        "fieldtype": "Currency",
        "options": "EUR",
        "insert_after": "custom_price_limit",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Labor Hours",
        "fieldname": "custom_labor_hours",
        "fieldtype": "Float",
        "insert_after": "custom_commission_eur",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Hourly Rate (€)",
        "fieldname": "custom_labor_rate_eur",
        "fieldtype": "Currency",
        "options": "EUR",
        "default": "20",
        "insert_after": "custom_labor_hours",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Deal Expenses",
        "fieldname": "custom_deal_expenses",
        "fieldtype": "Table",
        "options": "Deal Expense Item",
        "insert_after": "custom_labor_rate_eur",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Net Profit (€)",
        "fieldname": "custom_net_profit",
        "fieldtype": "Currency",
        "options": "EUR",
        "read_only": 1,
        "insert_after": "custom_deal_expenses",
        "description": "Auto-calculated: Sale Price − Purchase − Expenses − Labor − Commission",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "── Follow-up & Activity",
        "fieldname": "custom_followup_section",
        "fieldtype": "Section Break",
        "insert_after": "custom_net_profit",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Follow-up Target Date",
        "fieldname": "custom_followup_target_date",
        "fieldtype": "Date",
        "insert_after": "custom_followup_section",
        "description": "Set a future date to pause inactivity reminders until this date",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Follow-up Count",
        "fieldname": "custom_followup_count",
        "fieldtype": "Int",
        "read_only": 1,
        "default": "0",
        "insert_after": "custom_followup_target_date",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Handover Date",
        "fieldname": "custom_handover_date",
        "fieldtype": "Date",
        "insert_after": "custom_followup_count",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Key Count",
        "fieldname": "custom_key_count",
        "fieldtype": "Int",
        "insert_after": "custom_handover_date",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Fuel Level at Handover",
        "fieldname": "custom_fuel_level",
        "fieldtype": "Select",
        "options": "\n1/4\n1/2\n3/4\nFull",
        "insert_after": "custom_key_count",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Deal",
        "label": "Handover Notes",
        "fieldname": "custom_handover_notes",
        "fieldtype": "Small Text",
        "insert_after": "custom_fuel_level",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Contact",
        "label": "── Client Details",
        "fieldname": "custom_client_section",
        "fieldtype": "Section Break",
        "insert_after": "email_id",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Contact",
        "label": "Client Role",
        "fieldname": "custom_client_role",
        "fieldtype": "Select",
        "options": "\nSeller\nBuyer\nBoth",
        "insert_after": "custom_client_section",
        "in_list_view": 1,
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Contact",
        "label": "ID / Passport Number",
        "fieldname": "custom_id_number",
        "fieldtype": "Data",
        "insert_after": "custom_client_role",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Contact",
        "label": "Nationality",
        "fieldname": "custom_nationality",
        "fieldtype": "Data",
        "insert_after": "custom_id_number",
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Lead",
        "label": "Client Intent",
        "fieldname": "custom_client_intent",
        "fieldtype": "Select",
        "options": "\nBUY_INTENT\nSELL_INTENT\nUNKNOWN",
        "insert_after": "source",
        "in_list_view": 1,
        "module": "Car Agents CRM"
    },
    {
        "doctype": "Custom Field",
        "dt": "CRM Lead",
        "label": "Pipeline Type",
        "fieldname": "custom_pipeline_type",
        "fieldtype": "Select",
        "options": "\nsell\nbuy",
        "insert_after": "custom_client_intent",
        "module": "Car Agents CRM"
    }
]
