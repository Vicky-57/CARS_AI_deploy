# ─────────────────────────────────────────────────────────────────────────────
#  CAR-AGENTS Frappe CRM — Environment Configuration
#  Copy this file to .env and fill in your values before running docker-compose
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_strong_root_password
DB_NAME=car_agents_frappe
DB_USER=frappe_user
DB_PASSWORD=change_me_frappe_db_password

# ── Frappe Site ───────────────────────────────────────────────────────────────
FRAPPE_SITE_NAME=car-agents.localhost           # Change to your domain in production
FRAPPE_ADMIN_PASSWORD=change_me_admin_password

# ── Frappe API Auth (generated after first setup via Frappe desk) ─────────────
FRAPPE_URL=http://localhost:8080
FRAPPE_API_KEY=your_frappe_api_key_here
FRAPPE_API_SECRET=your_frappe_api_secret_here

# ── Local FastAPI OCR/Whisper Bridge ─────────────────────────────────────────
LOCAL_SERVICES_URL=http://localhost:9000

# ── Existing Keys (from main .env — copy as-is) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
GROQ_API_KEY=your_groq_api_key_here

WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
BRIEFING_WHATSAPP_RECIPIENT=your_whatsapp_number_here

SUPABASE_URL=https://wvzulyxzuntjnzdykstt.supabase.co
SUPABASE_SECRET_KEY=sb_secret_qM2kIa6iLOXbv_JAUEXNTA_YLbxemoo

# ── Google Calendar OAuth2 (Phase 7) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_ID=primary

# ── Microsoft Outlook OAuth2 (Phase 7) ───────────────────────────────────────
MS_TENANT_ID=your_azure_tenant_id
MS_CLIENT_ID=your_azure_app_client_id
MS_CLIENT_SECRET=your_azure_app_client_secret
